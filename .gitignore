# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# PyInstaller build artifacts (temp build folders and spec files)
build/
*.spec

# Ignore compiled worker binaries inside the bin folder (optional, see note below)
bin/

# Ignore the root launcher executable (if you don't want local .exe builds tracked in Git)
launcher.exe